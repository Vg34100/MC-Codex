{
  "schemaVersion": 1,
  "id": "codex",
  "version": "${version}",
  "name": "Codex",
  "description": "Minecraft-native advancement and quest authoring, party progression, and claimable rewards.",
  "authors": [
    "Vg34100"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "jei_mod_plugin": [
      "net.vg.codex.client.compat.jei.CodexJeiPlugin"
    ],
    "main": [
      "net.vg.codex.fabric.ModMainFabric"
    ],
    "client": [
      "net.vg.codex.fabric.client.ModMainFabricClient"
    ]
  },
  "mixins": [
    "codex.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  }
}
